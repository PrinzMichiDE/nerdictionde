        flex-shrink: 0;
        text-align: center;
        margin-bottom: 10px;
        color: #8A8A8A;
    }

    h1 {
        font-size: 36px;
        font-weight: 700;
        line-height: 40px;
    }

    h2 {
        font-size: 20px;
        font-weight: 700;
    }

    hr {
        background-color: #EDEDED;
        height: 1px;
        border: none;
        margin: 40px 0;
        width: 100%;
    }

    p, span, div {
        font-size: 16px;
        font-weight: 400;
        line-height: 24px;
    }

    small {
        font-size: 14px;
        font-weight: 400;
        line-height: 24px;
    }

    strong {
        font-weight: 700;
    }

    .flex {
        display: flex;
    }

    .mb-5 {
        margin-bottom: 20px;
    }

    .token {
        font-size: 14px;
        color: #8A8A8A;
    }

    .image {
        width: 80px;
        height: 80px;
    }

    a {
        color: #D50C2D;
    }

    .wrapper {
        align-items: center;
        justify-content: space-between;
        margin-bottom: 40px;
    }


    .image-mobile {
        display: none;
        align-items: center;
        justify-content: center;
        width: 21px;
        height: 24px;
        margin-right: 6px;
    }

    @media (max-width: 1024px) {
        main {
            max-width: 100%;
            align-self: auto;
        }
    }

    @media (max-width: 767px) {
        main {
            justify-content: start;
        }

        .image {
            display: none;
        }

        .image-mobile {
            display: block;
        }

        .image-mobile > img {
            width: 21px;
            height: 24px;
        }
    }


    </style>
  </head>
  <body>
  <main>
    <div style="padding: 16px;">
      <div class="flex wrapper">
        <div style="margin-right:20px;">
          <div class="flex" style="align-items: center;">
            <div class="image-mobile">
              <img src="/__ray_static/25-error.png" alt="Mobile image Heray">
            </div>
