generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Review {
  id              String          @id @default(cuid())
  title           String
  title_en        String?
  slug            String          @unique
  category        String // "game" | "hardware" | "amazon" | "movie" | "series"
  content         String // Markdown
  content_en      String? // Markdown English
  score           Int // 0-100
  pros            String[]
  pros_en         String[]
  cons            String[]
  cons_en         String[]
  images          String[] // Vercel Blob URLs
  youtubeVideos   String[] // YouTube video IDs or URLs (e.g., "dQw4w9WgXcQ" or "https://youtube.com/watch?v=dQw4w9WgXcQ")
  status          String          @default("draft") // "draft" | "published"
  igdbId          Int?
  tmdbId          Int? // TMDB ID for movies and series
  steamAppId      String?
  epicId          String? // Epic Games Store ID
  gogId           String? // GOG.com Store ID
  amazonAsin      String? // Amazon Product ASIN
  affiliateLink   String? // Amazon Affiliate Link
  hardwareId      String? // Reference to Hardware model
  specs           Json? // Hardware requirements or technical specs
  metadata        Json? // Additional IGDB metadata (developer, publisher, modes, etc.)
  metaDescription String? // SEO meta description (150-160 chars)
  metaKeywords    String? // SEO meta keywords (comma-separated)
  releaseDate     DateTime? // Release date for games, movies, series, hardware
  hardware        Hardware?       @relation(fields: [hardwareId], references: [id], onDelete: SetNull)
  comments        Comment[]
  userRatings     UserRating[]
  tags            ReviewTag[]
  priceHistory    PriceHistory[]
  deals           Deal[]
  priceAlerts     PriceAlert[]
  episodeReviews  EpisodeReview[]
  gameProgress    GameProgress[]
  videoChapters   VideoChapter[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([slug])
  @@index([category, status])
  @@index([amazonAsin])
  @@index([tmdbId])
  @@index([releaseDate])
  @@index([category, releaseDate])
}

model Comment {
  id        String   @id @default(cuid())
  text      String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reviewId  String
  author    String
  createdAt DateTime @default(now())

  @@index([reviewId])
}

model UserRating {
  id        String   @id @default(cuid())
  score     Int // 0-10
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reviewId  String
  createdAt DateTime @default(now())

  @@unique([reviewId]) // Ein Rating pro Review (später mit User-ID erweitern)
  @@index([reviewId])
}

model Hardware {
  id             String    @id @default(cuid())
  name           String
  name_en        String?
  slug           String    @unique
  type           String // "gpu" | "cpu" | "motherboard" | "ram" | "storage" | "psu" | "case" | "cooler" | "monitor" | "keyboard" | "mouse" | "headset" | "controller" | "console"
  manufacturer   String? // e.g. "NVIDIA", "AMD", "Intel", "Sony", "Microsoft"
  model          String? // e.g. "RTX 4090", "Ryzen 9 7950X", "PlayStation 5"
  specs          Json? // Technical specifications (varies by type)
  images         String[] // Product images URLs
  description    String? // Short description
  description_en String?
  releaseDate    DateTime?
  msrp           Float? // Manufacturer's suggested retail price
  reviews        Review[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([slug])
  @@index([type, manufacturer])
  @@index([name])
}

model PCBuild {
  id             String        @id @default(cuid())
  pricePoint     Int
  type           String        @default("desktop") // "desktop" | "laptop"
  title          String
  title_en       String?
  slug           String        @unique
  description    String?
  description_en String?
  image          String?
  image_en       String?
  totalPrice     Float
  currency       String        @default("EUR")
  status         String        @default("draft") // "draft" | "published"
  affiliateLink  String?
  lastScrapedAt  DateTime?
  metadata       Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  components     PCComponent[]

  @@unique([pricePoint, type])
  @@index([pricePoint])
  @@index([slug])
  @@index([status])
}

model PCComponent {
  id             String   @id @default(cuid())
  pcBuildId      String
  type           String // "CPU" | "GPU" | "Motherboard" | "RAM" | "SSD" | "PSU" | "Case" | "Cooler" | etc.
  name           String
  manufacturer   String?
  model          String?
  image          String?
  description    String?
  description_en String?
  price          Float?
  currency       String   @default("EUR")
  affiliateLink  String?
  reviewId       String?
  specs          Json?
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  pcBuild        PCBuild  @relation(fields: [pcBuildId], references: [id], onDelete: Cascade)

  @@index([pcBuildId])
  @@index([type])
}

model BulkJob {
  id                     String        @id @default(cuid())
  jobId                  String        @unique
  status                 String // "pending" | "running" | "completed" | "failed"
  category               String // "game" | "movie" | "series" | "hardware" | "product"
  total                  Int
  processed              Int           @default(0)
  successful             Int           @default(0)
  failed                 Int           @default(0)
  skipped                Int           @default(0)
  currentBatch           Int           @default(0)
  totalBatches           Int           @default(0)
  config                 Json?
  startTime              DateTime      @default(now())
  endTime                DateTime?
  estimatedTimeRemaining Int?
  errors                 Json?
  reviews                Json?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  queue                  BulkJobItem[]

  @@index([status])
  @@index([createdAt])
}

model BulkJobItem {
  id        String   @id @default(cuid())
  jobId     String
  job       BulkJob  @relation(fields: [jobId], references: [jobId], onDelete: Cascade)
  name      String
  igdbId    Int?
  tmdbId    Int?
  status    String   @default("pending") // "pending" | "processing" | "completed" | "failed" | "skipped"
  error     String?
  reviewId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobId])
  @@index([status])
}

model Tag {
  id          String      @id @default(cuid())
  name        String      @unique
  slug        String      @unique
  category    String?
  reviewCount Int?
  reviews     ReviewTag[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([name])
}

model ReviewTag {
  id        String    @id @default(cuid())
  reviewId  String
  tagId     String
  review    Review    @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  tag       Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt DateTime? @default(now())

  @@unique([reviewId, tagId])
  @@index([reviewId])
  @@index([tagId])
}

model PriceHistory {
  id         String   @id @default(cuid())
  reviewId   String
  review     Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  price      Float
  currency   String   @default("EUR")
  source     String
  url        String?
  recordedAt DateTime @default(now())

  @@index([reviewId, recordedAt])
}

model Deal {
  id            String    @id @default(cuid())
  title         String
  price         Float
  originalPrice Float?
  discount      Float?
  currency      String    @default("EUR")
  url           String
  imageUrl      String?
  source        String    @default("mydealz")
  category      String?
  reviewId      String?
  review        Review?   @relation(fields: [reviewId], references: [id], onDelete: SetNull)
  asin          String?
  status        String    @default("active") // "active" | "expired" | "invalid"
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([reviewId])
  @@index([status, createdAt])
  @@index([asin])
}

model PriceAlert {
  id          String   @id @default(cuid())
  userId      String?
  reviewId    String
  review      Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  targetPrice Float
  email       String?
  notified    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([reviewId])
}

model UserPCBuild {
  id         String   @id @default(cuid())
  userId     String?
  name       String
  components Json // Array of component IDs / config
  totalPrice Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

model EpisodeReview {
  id        String   @id @default(cuid())
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  season    Int
  episode   Int
  title     String?
  score     Int?
  notes     String?
  createdAt DateTime @default(now())

  @@unique([reviewId, season, episode])
  @@index([reviewId])
}

model GameProgress {
  id            String   @id @default(cuid())
  reviewId      String
  review        Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  playtimeHours Float?
  completion    Int?
  achievements  Int?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([reviewId])
}

model VideoChapter {
  id          String  @id @default(cuid())
  reviewId    String
  review      Review  @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  videoId     String
  title       String
  timestamp   Int // seconds
  description String?

  @@index([reviewId, videoId])
}

// Twitch Streaming Tools Models

model TwitchUser {
  id              String    @id @default(cuid())
  twitchId        String    @unique
  username        String    @unique
  displayName     String
  email           String?
  profileImageUrl String?
  accessToken     String
  refreshToken    String?
  tokenExpiresAt  DateTime?
  broadcasterType String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  schedules           StreamSchedule[]
  chatCommands        ChatCommand[]
  clips               StreamClip[]
  emotes              StreamEmote[]
  alerts              StreamAlert[]
  donations           StreamDonation[]
  notes               StreamNote[]
  overlays            StreamOverlay[]
  thumbnails          StreamThumbnail[]
  panels              StreamPanel[]
  banners             StreamBanner[]
  gamePerformances    GamePerformance[]
  gameLibrary         GameLibrary[]
  scenes              StreamScene[]
  widgets             StreamWidget[]
  transitions         StreamTransition[]
  introOutros         StreamIntroOutro[]
  checklists          StreamChecklist[]
  goals               StreamGoal[]
  streaks             StreamStreak?          @relation("StreamStreakUser")
  raidsHosts          StreamRaidHost[]
  polls               StreamPoll[]
  giveaways           StreamGiveaway[]
  moderationRules     StreamModerationRule[]
  musicPlaylists      StreamMusicPlaylist[]
  locations           StreamLocation[]
  routes              StreamRoute[]
  pois                StreamPOI[]
  weatherData         StreamWeather[]
  safetyContacts      StreamSafetyContact[]
  interruptions       StreamInterruption[]
  mobileSetups        MobileStreamSetup[]
  speedTests          NetworkSpeedTest[]
  batteryStatuses     BatteryStatus[]
  dataUsages          DataUsage[]
  contentIdeas        IRLContentIdea[]
  socialPosts         SocialMediaPost[]
  bioLink             BioLink?               @relation("BioLinkUser")
  affiliateLinks      AffiliateLink[]
  sponsorPitches      SponsorPitch[]
  mediaKit            MediaKit?              @relation("MediaKitUser")
  revenueEntries      RevenueEntry[]
  invoices            Invoice[]
  communityEvents     CommunityEvent[]
  viewerProfiles      ViewerProfile[]
  communityChallenges CommunityChallenge[]
  brandingProfile     BrandingProfile?       @relation("BrandingProfileUser")
  soundEffects        SoundEffect[]
  gameVotings         GameVoting[]
  subathonConfig      SubathonConfig?        @relation("SubathonConfigUser")
  challengeWheelItems ChallengeWheelItem[]
  bingoCards          BingoCard[]
  healthReminders     HealthReminder[]
  healthLogs          HealthLog[]
  sleepEntries        SleepEntry[]
  collabContacts      CollabContact[]
  collabEvents        CollabEvent[]
  autoReplyRules      AutoReplyRule[]
  streamDeckProfiles  StreamDeckProfile[]
  obsMacros           OBSMacro[]
  chatSentimentLogs   ChatSentimentLog[]
  retentionData       ViewerRetentionData[]
  competitorTracks    CompetitorTrack[]
  contentCalendar     ContentCalendarEntry[]
  multiStreamConfig   MultiStreamConfig?     @relation("MultiStreamConfigUser")
  youtubeVodQueue     YouTubeVODQueue[]

  @@index([twitchId])
  @@index([username])
}

model StreamSchedule {
  id          String     @id @default(cuid())
  userId      String
  user        TwitchUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  game        String?
  startTime   DateTime
  endTime     DateTime?
  timezone    String     @default("Europe/Berlin")
  isRecurring Boolean    @default(false)
  recurrence  String?
  tags        String[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([userId])
}

model ChatCommand {
  id         String     @id @default(cuid())
  userId     String
  user       TwitchUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  command    String
  response   String
  cooldown   Int?       @default(0)
  userLevel  String     @default("everyone")
  enabled    Boolean    @default(true)
  usageCount Int        @default(0)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([userId, command])
  @@index([userId])
}

model StreamClip {
  id           String     @id @default(cuid())
  userId       String
  user         TwitchUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  clipId       String
  title        String
  game         String?
  duration     Int
  viewCount    Int        @default(0)
  url          String
  thumbnailUrl String?
  tags         String[]
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([userId, clipId])
  @@index([userId])
}

model StreamEmote {
  id         String     @id @default(cuid())
  userId     String
  user       TwitchUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  imageUrl   String
  source     String
  tier       String?
  isActive   Boolean    @default(true)
  usageCount Int        @default(0)
  createdAt  DateTime   @default(now())

  @@index([userId])
}

model StreamAlert {
  id        String     @id @default(cuid())
  userId    String
  user      TwitchUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  enabled   Boolean    @default(true)
  soundUrl  String?
  imageUrl  String?
  message   String?
  duration  Int        @default(5000)
  volume    Float      @default(0.8)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId])
}

model StreamDonation {
  id          String     @id @default(cuid())
  userId      String
  user        TwitchUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Float
  currency    String     @default("EUR")
  donorName   String
  message     String?
  isAnonymous Boolean    @default(false)
  createdAt   DateTime   @default(now())

  @@index([userId])
}

model StreamNote {
  id         String     @id @default(cuid())
  userId     String
  user       TwitchUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  content    String
  category   String?
  streamDate DateTime?
  isTemplate Boolean    @default(false)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([userId])
}

model StreamOverlay {
  id         String     @id @default(cuid())
  userId     String
  user       TwitchUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  config     Json
  previewUrl String?
  isActive   Boolean    @default(false)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([userId])
}

model StreamThumbnail {
  id         String     @id @default(cuid())
  userId     String
  user       TwitchUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  imageUrl   String
  templateId String?
  game       String?
  createdAt  DateTime   @default(now())

  @@index([userId])
}

model StreamPanel {
  id        String     @id @default(cuid())
  userId    String
  user      TwitchUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  content   String
  imageUrl  String?
  linkUrl   String?
  position  Int
  isVisible Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId])
}

model StreamBanner {
  id        String     @id @default(cuid())
  userId    String
  user      TwitchUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  imageUrl  String
  text      String?
  isActive  Boolean    @default(false)
  createdAt DateTime   @default(now())

  @@index([userId])
}

model GamePerformance {
  id          String     @id @default(cuid())
  userId      String
  user        TwitchUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameId      String
  gameName    String
  streamDate  DateTime
  avgViewers  Int
  peakViewers Int
  duration    Int
  createdAt   DateTime   @default(now())

  @@index([userId])
}

model GameLibrary {
  id         String     @id @default(cuid())
  userId     String
  user       TwitchUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameId     String
  gameName   String
  platform   String?
  tags       String[]
  playtime   Int?
  isFavorite Boolean    @default(false)
  notes      String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([userId, gameId])
  @@index([userId])
}

model StreamScene {
  id         String     @id @default(cuid())
  userId     String
  user       TwitchUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  config     Json
  transition String?
  hotkey     String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([userId])
}

model StreamWidget {
  id        String     @id @default(cuid())
  userId    String
  user      TwitchUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  config    Json
  htmlCode  String
  isActive  Boolean    @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId])
}

model StreamTransition {
  id        String     @id @default(cuid())
  userId    String
  user      TwitchUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  type      String
  config    Json
  duration  Int
  soundUrl  String?
  createdAt DateTime   @default(now())

  @@index([userId])
}

model StreamIntroOutro {
  id         String     @id @default(cuid())
  userId     String
  user       TwitchUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String
  videoUrl   String
  duration   Int
  templateId String?
  createdAt  DateTime   @default(now())

  @@index([userId])
}

model StreamChecklist {
  id         String     @id @default(cuid())
  userId     String
  user       TwitchUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  items      Json
  category   String?
  isTemplate Boolean    @default(false)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([userId])
}

model StreamGoal {
  id        String     @id @default(cuid())
  userId    String
  user      TwitchUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  target    Float
  current   Float      @default(0)
  deadline  DateTime?
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId])
}

model StreamStreak {
  id             String     @id @default(cuid())
  userId         String     @unique
  user           TwitchUser @relation("StreamStreakUser", fields: [userId], references: [id], onDelete: Cascade)
  currentStreak  Int        @default(0)
  longestStreak  Int        @default(0)
  lastStreamDate DateTime?
  streakHistory  Json
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([userId])
}

model StreamRaidHost {
  id          String     @id @default(cuid())
  userId      String
  user        TwitchUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String
  fromChannel String
  toChannel   String
  viewerCount Int?
  timestamp   DateTime
  createdAt   DateTime   @default(now())

  @@index([userId])
}

model StreamPoll {
  id        String     @id @default(cuid())
  userId    String
  user      TwitchUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  options   Json
  duration  Int
  isActive  Boolean    @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId])
}

model StreamGiveaway {
  id          String     @id @default(cuid())
  userId      String
  user        TwitchUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  entries     Json
  winnerId    String?
  rules       String?
  endDate     DateTime
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([userId])
}

model StreamModerationRule {
  id        String     @id @default(cuid())
  userId    String
  user      TwitchUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  pattern   String
  action    String
  duration  Int?
  enabled   Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId])
}

model StreamMusicPlaylist {
  id        String     @id @default(cuid())
  userId    String
  user      TwitchUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  tracks    Json
  volume    Float      @default(0.8)
  fadeIn    Int        @default(0)
  fadeOut   Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId])
}

// IRL Streaming Models

model StreamLocation {
  id        String     @id @default(cuid())
  userId    String
  user      TwitchUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  latitude  Float
  longitude Float
  address   String?
  city      String?
  country   String?
  timestamp DateTime
  streamId  String?
  isPublic  Boolean    @default(false)
  createdAt DateTime   @default(now())

  @@index([userId])
}

model StreamRoute {
  id        String     @id @default(cuid())
  userId    String
  user      TwitchUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  waypoints Json
  distance  Float?
  duration  Int?
  isPublic  Boolean    @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId])
}

model StreamPOI {
  id          String     @id @default(cuid())
  userId      String
  user        TwitchUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  latitude    Float
  longitude   Float
  category    String
  description String?
  rating      Float?
  isFavorite  Boolean    @default(false)
  createdAt   DateTime   @default(now())

  @@index([userId])
}

model StreamWeather {
  id          String     @id @default(cuid())
  userId      String
  user        TwitchUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  locationId  String
  temperature Float
  condition   String
  humidity    Float?
  windSpeed   Float?
  timestamp   DateTime
  createdAt   DateTime   @default(now())

  @@index([userId])
}

model StreamSafetyContact {
  id           String     @id @default(cuid())
  userId       String
  user         TwitchUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  phone        String
  email        String?
  relationship String
  isPrimary    Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([userId])
