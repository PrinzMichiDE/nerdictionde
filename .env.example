# Vorlage für lokale Entwicklung und Self-Hosting.
# Kopieren nach .env und Werte eintragen: cp .env.example .env
# .env wird nicht committet. Ohne echte Werte starten die betroffenen
# Features nicht (z. B. Twitch-Login, KI-Generierung, Push).

# ---------------------------------------------------------------------------
# Datenbank
# ---------------------------------------------------------------------------
# Hosted Postgres (Neon, Supabase, Prisma Postgres, ...) oder lokal:
# postgresql://user:passwort@localhost:5432/nerdiction?schema=public
DATABASE_URL="postgresql://nerdiction:nerdiction@localhost:5432/nerdiction?schema=public"
# Nur für direkte Prisma-Verbindungen ohne Pooler nötig, sonst wie DATABASE_URL.
DIRECT_URL="postgresql://nerdiction:nerdiction@localhost:5432/nerdiction?schema=public"

# Nur für docker-compose.yml: Zugangsdaten der mitgelieferten Datenbank.
POSTGRES_USER="nerdiction"
POSTGRES_PASSWORD="nerdiction"
POSTGRES_DB="nerdiction"

# ---------------------------------------------------------------------------
# Auth und Sicherheit
# ---------------------------------------------------------------------------
# Mindestens 32 Zeichen für die JWT-Signatur von Sessions.
JWT_SECRET="change-me-to-a-random-string-of-at-least-32-chars"
# Exakt 32 Zeichen (AES-256-GCM verschlüsselt damit Twitch-Tokens).
ENCRYPTION_KEY="change-me-to-exactly-32-characters!"
# Token für /admin und geschützte Admin-APIs.
ADMIN_TOKEN="change-me"
# Bearer-Token für die /api/cron/*-Endpunkte. Leer = Endpunkte ungeschützt.
CRON_SECRET="change-me"
# Name des Session-Cookies, optional.
SESSION_COOKIE_NAME="twitch_session"

# ---------------------------------------------------------------------------
# Öffentliche URLs (zur Build-Zeit eingebettet, danach unveränderlich)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Twitch-Login
# ---------------------------------------------------------------------------
TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""
# Muss in der Twitch-App als Redirect-URI eingetragen sein.
TWITCH_REDIRECT_URI="http://localhost:3000/api/auth/twitch/callback"

# ---------------------------------------------------------------------------
# Push-Benachrichtigungen (VAPID)
# ---------------------------------------------------------------------------
# Erzeugen mit: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# ---------------------------------------------------------------------------
# KI-Generierung (OpenAI-kompatibel, z. B. OpenRouter)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=""
OPENAI_CUSTOM_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4"

# ---------------------------------------------------------------------------
# Externe Datenquellen
# ---------------------------------------------------------------------------
TMDB_API_KEY=""
IGDB_CLIENT_ID=""
IGDB_CLIENT_SECRET=""
TAVILY_API_KEY=""
# Vercel Blob für Bilder-Uploads im Admin.
BLOB_READ_WRITE_TOKEN=""

# ---------------------------------------------------------------------------
# News-Sync (optional, Defaults stehen im Code)
# ---------------------------------------------------------------------------
# Optionaler zusätzlicher RSS-Feed. Die Basis-Feeds (Gaming, Technik,
# Hardware, Filme & Serien, Unterhaltung, Wirtschaft) liegen in
# src/lib/news-sources.ts.
NEWS_RSS_FEED=""
# Neue Beiträge pro Lauf (Standard: 8).
NEWS_MAX_PER_RUN="8"
# Mindestabstand zwischen manuellen Syncs in Minuten (Standard: 60).
NEWS_SYNC_COOLDOWN_MIN="60"
