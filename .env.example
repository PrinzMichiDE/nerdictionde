# Nerdiction.de Environment Variables
# Copy to .env.local and fill in your values

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/nerdiction?schema=public"

# Next.js
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="https://nerdiction.de"

# Twitch OAuth (for user auth)
TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""
TWITCH_REDIRECT_URI="http://localhost:3000/api/auth/twitch/callback"

# Session
SESSION_SECRET="your-super-secret-session-key-change-in-production"

# Email (Newsletter)
RESEND_API_KEY=""
NEWSLETTER_FROM_EMAIL="newsletter@nerdiction.de"

# IGDB (Game data)
IGDB_CLIENT_ID=""
IGDB_CLIENT_SECRET=""

# TMDB (Movies/Series)
TMDB_API_KEY=""

# MyDealz (Deals)
MYDEALZ_API_KEY=""

# Feature Flags
FEATURE_ADVANCED_SEARCH_FILTERS="true"
FEATURE_REVIEW_COLLECTIONS="true"
FEATURE_REVIEW_REACTIONS="true"
FEATURE_PUBLIC_USER_PROFILES="true"
FEATURE_COLLECTIONS_FOLLOW="true"
FEATURE_READING_HISTORY="true"
FEATURE_CATEGORY_SUBSCRIPTIONS="true"
FEATURE_REVIEW_COMPARE_ENHANCED="true"
FEATURE_REVIEW_SERIES="true"
FEATURE_COMMUNITY_QA="true"
FEATURE_PERSONALIZED_RECOMMENDATIONS="true"
FEATURE_REVIEW_TEMPLATES="false"
FEATURE_SOCIAL_SHARING="true"
FEATURE_SHARE_TRACKING="true"

# Vercel Blob (Images)
BLOB_READ_WRITE_TOKEN=""

# Push Notifications
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@nerdiction.de"